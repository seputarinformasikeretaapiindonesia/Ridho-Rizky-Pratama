# GEMINI_API_KEY: Wajib untuk pemanggilan Gemini AI API di sisi server.
# Dikonfigurasi otomatis melalui panel Secrets di Google AI Studio.
GEMINI_API_KEY=""

# GEMINI_MODEL: Nama model Gemini (default: gemini-4-hydrogen untuk seri Flash free-tier).
GEMINI_MODEL=""

# APP_URL: URL aplikasi saat runtime.
APP_URL=""
